    "is-ci": "^4.1.0",
    "lint-staged": "^17.0.8",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.0"
    }
  },
  "packageManager": "pnpm@11.17.0"

{
  "name": "shadscan-vue-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Audit shadcn-vue and shadcn-nuxt apps for missing UI fundamentals. Vue port of shadscan by TheOrcDev.",
  "homepage": "https://github.com/vinayakkulkarni/shadscan-vue#readme",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/shadscan-vue/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/shadscan-vue.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter shadscan-vue run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "is-ci || husky",
    "qa:expected": "node scripts/qa-expected.ts",
    "qa:scan": "node packages/cli/bin/shadscan-vue.mjs qa/vite-app && node packages/cli/bin/shadscan-vue.mjs qa/nuxt-app",
    "docs:rules": "node packages/cli/bin/shadscan-vue.mjs rules > docs/RULES.md && node packages/cli/bin/shadscan-vue.mjs rules --format json > apps/www/app/data/rules.json",
    "docs:changelog": "node scripts/changelog-data.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
